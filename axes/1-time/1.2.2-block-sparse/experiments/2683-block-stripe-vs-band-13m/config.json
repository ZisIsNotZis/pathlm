  "pattern": {
    "name": "块条带（block stripe）",
    "formula": "keep[i,j] = (j<=i) & ((i-j) < LOCAL | j in [START, START+BLOCK))，START = max(0, floor(i/BLOCK) - LAG) * BLOCK",
    "local": 16,
    "block": 8,
    "lag_blocks": 4,
    "k_eff": 24,
    "far_distance_range": "远块落在距离 [25 + r, 32 + r]（r = i mod 8，0–7）",
