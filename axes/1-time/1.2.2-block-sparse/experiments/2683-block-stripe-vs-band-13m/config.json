    "band_bpc": 0.014,
    "band_scope": "只用于配对 Δ（harness/methodology.md §2）；率类指标不借用",
    "delta_direction": "Δ = bpc_对照 − bpc_实验（对照 = 均匀条带，实验 = 块条带；正 = 块条带更好）",
    "three_way": {"delta_ge_+0.014": "块条带占优", "abs_delta_lt_0.014": "无质量增量", "delta_le_-0.014": "块条带更差"},
    "n_seed": 2
