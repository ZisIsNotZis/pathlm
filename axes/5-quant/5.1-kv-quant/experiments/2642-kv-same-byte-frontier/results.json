{
  "experiment": "2642-kv-same-byte-frontier",
  "kind": "re-analysis（纯读数重排；无前向、无训练、不占 GPU 锁、不联网）",
  "contract": "axes/5-quant/5.1-kv-quant/experiments/2642-kv-same-byte-frontier/README.md",
  "criterion": {
    "verbatim": [
      "G1 门禁：独立重算的 27 臂部署字节与 2632::deployment_caliber.per_arm[*].primary.bytes_per_position 逐位相等（max|Δ| = 0），否则本实验作废",
      "G2 门禁：进入前沿表的量化臂全部为块标尺（scheme=block, G=32）；出现 per_value 量化数字 ⇒ 作废",
      "必须报：每点 (部署字节, bpc, copy 召回, 参数量, 族) 五元组 + 同字节分组 + 被支配点清单 + fp8 解析点（quality_measured=false）",
      "必须不变：非量化臂 bpc/召回与 2632 记录逐位相同",
      "不得：插值造点；把 staging 混进主横轴；把仅值口径当部署口径；拿头共享字节优势下结论而不带参数量列"
    ],
    "variance_band_bpc_in_force": 0.036324,
    "variance_band_source": "2632::ranking_band.in_force_band_bpc（单臂跨窗口极差；配对 Δ 口径需 ≥5 窗口，本批 3 个 ⇒ 退用更保守的单臂带）",
    "recall_leg": "copy 召回 + Wilson 95% CI 重叠判定（不设绝对门槛；显著性以 CI 是否含对方点为据）",
    "no_extrapolation": "T=256 单点；head_dim=32；窗口臂的 kept/T 与 T 有关"
  },
  "gates": {
    "G1_independent_recompute_matches_2632": true,
    "G1_max_abs_diff_deployment_bytes": 0.0,
    "G2_all_quantized_arms_use_block_scale": true,
    "G2_offenders": [],
    "value_only_caliber_agrees": true,
    "values_unchanged_bitwise_ok": true,
    "parent_nonquant_bitwise_preserved": true,
    "parent_nonquant_max_abs_delta_bpc": 0.0,
    "verdict": "PROCEED"
  },
